# ── Supabase ────────────────────────────────────────────────────────────────
# Criar projeto em https://supabase.com (região: Frankfurt/eu-central-1)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# SEGREDO — só de servidor. Project Settings → API → service_role. Nunca NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# ── Notificações web push (VAPID) ───────────────────────────────────────────
# Par de chaves gerado com `npx web-push generate-vapid-keys`.
# Obrigatório para a "Dica do dia" e lembretes de metas por push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-vapid
VAPID_PRIVATE_KEY=chave-privada-vapid
VAPID_SUBJECT=mailto:tu@dominio.pt

# ── Segurança dos crons ──────────────────────────────────────────────────────
# Aleatório (ex.: `openssl rand -hex 32`). As rotas /api/cron/* aceitam-no via
# header `x-cron-secret` ou `Authorization: Bearer`.
CRON_SECRET=segredo-do-cron

# ── Emails (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=sua-chave-api-resend
RESEND_FROM=OptiFi <no-reply@dominio.pt>

# ── App móvel (Expo) ─────────────────────────────────────────────────────────
# Expo lê as EXPO_PUBLIC_* do .env na raiz do package do mobile (apps/mobile/.env).
# EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Para onde os links de email da app voltam. Padrão: optifi://auth/confirm
# (build de loja). No Expo Go, usa o URL exp:// do teu dev server.
# EXPO_PUBLIC_AUTH_REDIRECT=optifi://auth/confirm
# Site público (termos/privacidade).
# EXPO_PUBLIC_WEB_URL=https://optifi.pt