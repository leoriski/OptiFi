# O npm instala peer deps automaticamente e escolhe a versão mais recente que as
# satisfaça. Num monorepo com uma app Expo isso é destrutivo: o peer
# `react-native: "*"` do async-storage puxava o react-native 0.86, o peer
# `expo: "*"` do expo-router puxava o expo 57, e ficávamos com duas cópias de
# react-native/react/expo na mesma app — o bundle rebenta ou dá "Invalid hook
# call". As versões certas já estão todas escritas nos package.json das apps
# (é o que o `expo install` faz), por isso não precisamos que o npm as adivinhe.
legacy-peer-deps=true
